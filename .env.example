# MongoDB Connection String (Optional - App falls back to interactive Mock Store if absent)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/bricks?retryWrites=true&w=majority

# Admin password guarding /admin and the Attendance, Billing, Materials, Splitter & Ledger modules.
# Falls back to "admin@123" when unset. Changing it revokes every active admin session.
ADMIN_PASSWORD=admin@123
# Uncomment if production is served over plain HTTP (keeps the session cookie working)
# ALLOW_INSECURE_COOKIE=true